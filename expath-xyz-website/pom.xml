<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>xyz.expath.cg</groupId>
        <artifactId>expath-cg-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../expath-cg-parent</relativePath>
    </parent>

    <artifactId>expath-xyz-website</artifactId>
    <packaging>pom</packaging>

    <name>EXPath Community Group - EXPath XYZ Website</name>
    <description>The expath.xyz website</description>

    <scm>
        <connection>scm:git:https://github.com/evolvedbinary/expath-xyz.git</connection>
        <developerConnection>scm:git:https://github.com/evolvedbinary/expath-xyz.git</developerConnection>
        <url>scm:git:https://github.com/evolvedbinary/expath-xyz.git</url>
    </scm>

    <dependencies>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>expath-cg-distribution</artifactId>
            <version>${project.version}</version>
            <type>pom</type>
        </dependency>
    </dependencies>

    <properties>
        <xml.input.dir>${project.basedir}/src/main/xhtml</xml.input.dir>
        <css.input.dir>${project.basedir}/src/main/css</css.input.dir>
        <website.output.dir>${project.build.directory}/website</website.output.dir>
        <website.specs.output.dir>${website.output.dir}/specs</website.specs.output.dir>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>

                    <!-- Copy static website files (CSS) -->
                    <execution>
                        <id>copy-static-website</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <resources>
                                <resource>
                                    <directory>${css.input.dir}</directory>
                                </resource>
                            </resources>
                            <outputDirectory>${website.output.dir}</outputDirectory>
                        </configuration>
                    </execution>

                    <!-- Copy generated spec HTML files from each module -->
                    <execution>
                        <id>copy-specs</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/../expath-cg-distribution/target/expath-cg-distribution-${project.version}</directory>
                                </resource>
                            </resources>
                            <outputDirectory>${website.specs.output.dir}</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>nu.validator</groupId>
                <artifactId>vnu-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>validate-input</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>validate</goal>
                        </goals>
                        <configuration>
                            <filesets>
                                <fileset>
                                    <directory>${xml.input.dir}</directory>
                                    <glob>spec-index.xhtml</glob>
                                </fileset>
                            </filesets>
                        </configuration>
                    </execution>
                    <execution>
                        <id>validate-output</id>
                        <phase>process-classes</phase>
                        <goals>
                            <goal>validate</goal>
                        </goals>
                        <configuration>
                            <filesets>
                                <fileset>
                                    <directory>${website.output.dir}</directory>
                                    <glob>spec-index.xhtml</glob>
                                </fileset>
                            </filesets>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>com.evolvedbinary.maven.mojohaus</groupId>
                <artifactId>xml-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>transform</goal>
                        </goals>
                        <configuration>
                            <transformationSets>
                                <transformationSet>
                                    <dir>${xml.input.dir}</dir>
                                    <includes>
                                        <include>spec-index.xhtml</include>
                                    </includes>
                                    <stylesheet>${project.basedir}/src/main/xslt/spec-index.xslt</stylesheet>
                                    <parameters>
                                        <parameter>
                                            <name>spec-directory</name>
                                            <value>${website.specs.output.dir}</value>
                                        </parameter>
                                    </parameters>
                                    <outputDir>${website.output.dir}</outputDir>
                                    <fileMappers>
                                        <fileMapper implementation="org.codehaus.plexus.components.io.filemappers.FileExtensionMapper">
                                            <targetExtension>.xhtml</targetExtension>
                                        </fileMapper>
                                    </fileMappers>
                                </transformationSet>
                            </transformationSets>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

        </plugins>
    </build>
</project>