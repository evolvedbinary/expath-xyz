<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>xyz.expath.cg</groupId>
        <artifactId>expath-cg-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../../expath-cg-parent</relativePath>
    </parent>

    <artifactId>expath-archive-module-spec</artifactId>
    <packaging>jar</packaging>

    <name>EXPath Specification - Archive Module</name>
    <description>EXPath specification for a module of archive functions</description>

    <contributors>
        <contributor>
            <name>John Lumley</name>
            <email>john@saxonica.com</email>
            <organization>Saxonica Ltd</organization>
            <roles>
                <role>Editor</role>
            </roles>
        </contributor>
        <contributor>
            <name>Christian Grün</name>
            <email>christian.gruen@gmail.com</email>
            <organization>BaseX GmbH</organization>
            <roles>
                <role>Contributor</role>
            </roles>
        </contributor>
        <contributor>
            <name>Matthias Brantner</name>
            <email>>matthias.brantner@28msec.com</email>
            <organization>28msec GmbH</organization>
            <roles>
                <role>Contributor</role>
            </roles>
        </contributor>
        <contributor>
            <name>Florent Georges</name>
            <organization>H2O Consulting</organization>
            <roles>
                <role>Contributor</role>
            </roles>
        </contributor>
    </contributors>

    <scm>
        <connection>scm:git:https://github.com/evolvedbinary/expath-xyz.git</connection>
        <developerConnection>scm:git:https://github.com/evolvedbinary/expath-xyz.git</developerConnection>
        <url>scm:git:https://github.com/evolvedbinary/expath-xyz.git</url>
    </scm>

    <properties>
        <xml.input.dir>${project.basedir}/src/main/expathspec</xml.input.dir>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>com.mycila</groupId>
                <artifactId>license-maven-plugin</artifactId>
                <configuration>
                    <licenseSets>
                        <licenseSet>
                            <header>com/mycila/maven/plugin/license/templates/APACHE-2.txt</header>
                            <excludes>
                                <exclude>src/main/expathspec/**</exclude>
                                <exclude>src/test/qt3/**</exclude>
                            </excludes>
                        </licenseSet>
                    </licenseSets>
                </configuration>
            </plugin>

            <plugin>
                <groupId>com.evolvedbinary.maven.mojohaus</groupId>
                <artifactId>xml-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>validate</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>validate</goal>
                        </goals>
                        <configuration>
                            <catalogs>
                                <catalog>resource:catalog.xml</catalog>
                            </catalogs>
                            <validationSets>
                                <validationSet>
                                    <dir>${xml.input.dir}</dir>
                                    <includes>
                                        <include>**/function-catalog.xml</include>
                                    </includes>
                                    <systemId>resource:fos/fos.xsd</systemId>
                                    <schemaLanguage>http://www.w3.org/2001/XMLSchema</schemaLanguage>
                                </validationSet>
                                <validationSet>
                                    <dir>${xml.input.dir}</dir>
                                    <includes>
                                        <include>**/archive.xml</include>
                                    </includes>
                                    <systemId>resource:expathspec/xmlspec.rnc</systemId>
                                    <schemaLanguage>http://www.iana.org/assignments/media-types/application/relax-ng-compact-syntax</schemaLanguage>
                                    <schemaFactory>com.thaiopensource.relaxng.jaxp.CompactSyntaxSchemaFactory</schemaFactory>
                                </validationSet>
                            </validationSets>
                        </configuration>
                    </execution>
                </executions>
                <dependencies>
                    <dependency>
                        <groupId>${project.groupId}</groupId>
                        <artifactId>expath-cg-catalog</artifactId>
                        <version>${project.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>${project.groupId}</groupId>
                        <artifactId>w3c-xpath-functions-schema</artifactId>
                        <version>${project.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>${project.groupId}</groupId>
                        <artifactId>w3c-xml-schema</artifactId>
                        <version>${project.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>${project.groupId}</groupId>
                        <artifactId>expath-expathspec-schema</artifactId>
                        <version>${project.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>${project.groupId}</groupId>
                        <artifactId>w3c-xmlspec-schema</artifactId>
                        <version>${project.version}</version>
                    </dependency>
                </dependencies>
            </plugin>
        </plugins>
    </build>

</project>
