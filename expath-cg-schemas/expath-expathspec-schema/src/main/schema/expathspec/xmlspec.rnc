namespace ex = "http://expath.org/ns/xmlspec"

include "http://w3.org/2002/xmlspec/xmlspec.rnc" {

  # Override attlist.spec to make /spec/@w3c-doctype mandatory. We use this to infer the ReSpec specStatus.
  attlist.spec =
    common.att,
    local.spec.att,
    attribute w3c-doctype {
      "cr"
      | "dispcmts"
      | "issues"
      | "wgnote"
      | "memsub"
      | "teamsub"
      | "note"
      | "other"
      | "pr"
      | "per"
      | "rec"
      | "wd"
      | "review"
    },
    attribute other-doctype { text }?,
    attribute status { "int-review" | "ext-review" | "final" }?

  # Override attlist.title to make /spec/header/title/@role mandatory. We use this to store the short-name of the spec.
  attlist.title =
    attribute id { xsd:ID }?,
    attribute role { xsd:NMTOKEN },
    diff.att,
    local.common.att

  # Override back to make /spec/back/(div1|inform-div1)/@id mandatory. We use this to identifiy billioraphic references, error codes, etc.
  back =
    element back {
      attlist.back,
      ((back.div1+, back.inform-div1*) | back.inform-div1+)
    }
}

# Used instead of div1 in /spec/back.
back.div1 = element div1 { attlist.back.div1, head, div.mix*, div2* }

# Used instead of attlist.div1 in /spec/back/div1.
attlist.back.div1 &=
  attribute id { xsd:ID },
  role.att,
  diff.att,
  local.common.att

# Used instead of inform-div1 in /spec/back.
back.inform-div1 =
  element inform-div1 { attlist.back.inform-div1, head, div.mix*, div2* }

# Used instead of attlist.inform-div1 in /spec/back/inform-div1.
attlist.back.inform-div1 &=
  attribute id { xsd:ID },
  role.att,
  diff.att,
  local.common.att

exfunction = element ex:function { loc | text }

extype = element ex:type { text }

local.spec.att |=
   attribute ex:w3c { xsd:boolean }

local.eg.pcd.mix |=
   exfunction
   | extype
   
local.tech.class |=
   exfunction
   | extype
